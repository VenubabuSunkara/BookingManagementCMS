@model Booking.Application.DTOs.SettingsDto
@{
    if (Model is null)
        ViewData["Title"] = "Create Setting";
    else
        ViewData["Title"] = "Update Setting";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>@ViewData["Title"]</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Save" asp-controller="Settings" method="post" class="theme-form mega-form" enctype="multipart/form-data" >
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Id)
                                <div class="row">
                                    <div class="col-sm-12">
                                        <label asp-for="Name" class="form-label-title mt-3">Setting Name <span class="text-danger">*</span></label>
                                        <input asp-for="Name" class="form-control" type="text" placeholder="Name" autocomplete="off" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                    <div class="col-sm-12">
                                        <label asp-for="Value" class="form-label-title mt-3">Setting Value <span class="text-danger">*</span></label>
                                        <input asp-for="Value" class="form-control" type="text" placeholder="Setting value" autocomplete="off" />
                                        <span asp-validation-for="Value" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <button type="submit" class="btn btn-primary me-3" id="submitBtn">Save</button>
                                    <button type="reset" class="btn btn-warning me-3">Reset</button>
                                    <a asp-action="Index" asp-controller="Settings" class="btn btn-dark">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>