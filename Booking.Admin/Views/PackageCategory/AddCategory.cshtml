@model Booking.Application.DTOs.Tour.TourPackageCategoryDto
@{
    if (Model is null)
    {
        ViewData["Title"] = "Add Package Category";
    }
    else
    {
        ViewData["Title"] = "Update Package Category";
    }
}

<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-sm-12">
                    <form asp-action="SaveCategory" id="packageCategory" asp-controller="PackageCategory" method="post" enctype="multipart/form-data">
                        <div class="card">
                            <div class="card-header">
                                @if (Model is null)
                                {
                                    <h5>Add Package Category</h5>
                                }
                                else
                                {
                                    <h5>Update Package Category</h5>
                                }
                            </div>
                            <div class="card-body">
                                <div class="theme-form mega-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Id" />
                                    <div class="mb-3">
                                        <label asp-for="CategoryName" class="form-label-title">Category Name <span class="required-asterisk">*</span></label>
                                        <input class="form-control"  type="text" placeholder="Category name" asp-for="CategoryName" />
                                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Description" class="form-label-title">Description</label>
                                        <textarea asp-for="Description" class="form-control descriptionOf" placeholder="Category Description"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="IsActive" class="form-label-title">Is Active</label>
                                        <input type="checkbox" asp-for="IsActive" />
                                        <span asp-validation-for="IsActive" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <button class="btn btn-primary me-3" type="submit" id="submitButton">Submit</button>
                                <button class="btn btn-outline-primary" type="reset">Reset</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/adminjs/packagecaregoryvalidation.js"></script>    
}