@model Booking.Application.DTOs.QuickAssignmentViewModel
@{
    var today = DateTime.Today;
    var twoMonthsFromNow = today.AddMonths(2);
    string minDate = today.ToString("yyyy-MM-dd");
    string maxDate = twoMonthsFromNow.ToString("yyyy-MM-dd");
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>Quick Assignment</h5>
                        </div>
                        <div class="card-body">
                            <form id="quickAssignForm" asp-action="QuickAssign" asp-controller="Assignment">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <!-- start -->
                                    <div class="">
                                        <div class="row mb-3">
                                            <div class="col-6 mb-3">
                                                <label class="form-label-title" asp-for="Driver.FullName">@Model.Driver.FullName</label>
                                                <label asp-for="Driver.LicenseNumber" class="form-label-title">@Model.Driver.LicenseNumber</label>
                                                <input asp-for="Driver.Id" type="hidden" />
                                            </div>
                                            <div class="col-6 mb-3">
                                                <label class="form-label-title" asp-for="Vehicle.ModelName">@Model.Vehicle.ModelName</label>
                                                <label class="form-label-title" asp-for="Vehicle.Make">@Model.Vehicle.Make</label>
                                                <label asp-for="Vehicle.VehicleNumber" class="form-label-title">@Model.Vehicle.VehicleNumber</label>
                                                <input asp-for="Vehicle.Id" type="hidden" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-center">
                                        <label class="form-label-title">
                                            Add Transportation Sources
                                        </label>
                                    </div>
                                    <div id="transportation-container">
                                        <div class="row input-row">
                                            <div class="col-6 mb-3">
                                                <select asp-for="TripTypeId"
                                                        asp-items="Model.TripType"
                                                        class="form-control">
                                                    <option value="">Choose TripType</option>
                                                    <option value="1">Airport To Location</option>
                                                </select>
                                                <span asp-validation-for="TripTypeId" class="text-danger"></span>
                                            </div>
                                            <div class="col-6 mb-3">
                                                <select asp-for="VehicleTypeId"
                                                        asp-items="Model.VehicleType"
                                                        class="form-control">
                                                    <option value="">Choose VehicleType</option>
                                                    <option value="1">Sedan</option>
                                                </select>
                                                <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-center">
                                        <label class="form-label-title">
                                            Date Range
                                        </label>
                                    </div>
                                    <div id="route-container">
                                        <div class="route-form">
                                            <div class="mt-3">
                                                <div class="row mb-3">
                                                    <div class="col-12 col-md-6">

                                                        <input asp-for="Assignment.StartDate"
                                                               type="date" min="@minDate"
                                                               max="@maxDate"
                                                               class="form-control" />
                                                        <span asp-validation-for="Assignment.StartDate" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <input asp-for="Assignment.EndDate"
                                                               type="date" min="@minDate"
                                                               max="@maxDate"
                                                               class="form-control" />
                                                        <span asp-validation-for="Assignment.EndDate" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-center">
                                        <label class="form-label-title">
                                            Schedule Time
                                        </label>
                                    </div>
                                    <div id="route-container">
                                        <div class="route-form">
                                            <div class="mt-3">
                                                <div class="row mb-3">
                                                    <div class="col-12 col-md-6">
                                                        <input asp-for="Assignment.StartTime"
                                                               type="time"
                                                               class="form-control" />
                                                        <span asp-validation-for="Assignment.StartTime" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <input asp-for="Assignment.EndTime"
                                                               type="time"
                                                               class="form-control" />
                                                        <span asp-validation-for="Assignment.EndTime" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-center">
                                        <label class="form-label-title">
                                            Create Route
                                        </label>
                                        <button id="btn-add-route" class="mb-2 add-new-route btn btn-primary me-3">
                                            +Add New
                                        </button>
                                    </div>
                                    <div id="route-container">
                                        <div class="route-form">
                                            <input class="form-control" asp-for="@Model.Routes[0].RouteName"
                                                   type="text"
                                                   placeholder="Add Route Headline" />
                                            <input class="form-control mt-3"
                                                   type="text"
                                                   placeholder="Add Destination" />

                                            <div class="mt-3">
                                                <div class="row mb-3">
                                                    <div class="col-12 col-md-6">
                                                        <select class="form-control">
                                                            <option value="">
                                                                City/Location: 1
                                                            </option>
                                                            <option value="india">India</option>
                                                            <option value="usa">USA</option>
                                                            <option value="canada">Canada</option>
                                                            <option value="australia">
                                                                Australia
                                                            </option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <select class="form-control">
                                                            <option value="">
                                                                City/Location: 2
                                                            </option>
                                                            <option value="delhi">Delhi</option>
                                                            <option value="newyork">
                                                                New York
                                                            </option>
                                                            <option value="toronto">Toronto</option>
                                                            <option value="sydney">Sydney</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <div class="row mb-3">
                                                    <div class="col-12 col-md-6">
                                                        <input class="form-control"
                                                               type="number"
                                                               placeholder="Distance" />
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <input class="form-control"
                                                               type="time"
                                                               placeholder="Duration/Time" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- end route -->
                                <div class="card-footer text-end">
                                    <button class="btn btn-primary me-3" type="submit">Submit</button>
                                    <button class="btn btn-outline-primary" type="button">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Container-fluid Ends-->
