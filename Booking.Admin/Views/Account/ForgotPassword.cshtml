@model Booking.Application.DTOs.ForgotPasswordDto
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password";
}
<div>
    <div>
        <a class="logo" href="index.html">
            <img class="img-fluid for-light"
                 src="/wecare_logo.svg"
                 width="100px"
                 alt="looginpage" />
            <img class="img-fluid for-dark"
                 src="/wecare_logo.svg"
                 alt="looginpage" />
        </a>
    </div>
    <div class="login-main">
        <form class="theme-form" asp-action="ForgotPassword" asp-controller="Account" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <h4>@ViewData["Title"]</h4>
            <div class="form-group">
                <label asp-for="Email" class="col-form-label form-label-title"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your registered email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-0">
                <div class="text-end mt-3">
                    <button class="btn btn-primary btn-block w-100" type="submit">
                        Send Reset Link
                    </button>
                </div>
            </div>
            <p class="mt-4 mb-0">
                Already have an account?<a class="ms-2" asp-action="Login" asp-controller="Account">Sign in</a>
            </p>
        </form>
    </div>
</div>