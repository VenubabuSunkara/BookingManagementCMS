@model Booking.Application.DTOs.DriverDto

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header card-header--2 package-card">
                    <div>
                        <h5>Driver Vehicle Details</h5>
                    </div>
                    <form asp-action="ProcessDriver" asp-controller="Driver" method="post" class="d-inline-flex">
                        <div class="d-flex gap-2">
                            <input type="hidden" name="DriverId" value="@Model.Id" />

                            <button type="submit" name="actionType" value="Approve"
                                    class="btn align-items-center btn-theme me-3">
                                <i class="fa fa-check-circle-o me-2"></i>Approve
                            </button>

                            <button type="submit" name="actionType" value="Reject"
                                    class="btn align-items-center d-flex btn-outline">
                                <i class="fa fa-trash-o me-2"></i>Reject
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-body">
                    <!-- section start -->
                    <section class="single-section small-section bg-inner">
                        <div class="row">
                            <h2 class="cars-title mb-2 mt-2">@Model.GetFullName()</h2>
                            <div class="col-12">
                                <div class="image_section">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="responsive arrow-dark zoom-gallery ratio2_3">
                                                <div>
                                                    <a href="@Model.Photo">
                                                        <img src="@Model.Photo"
                                                             class="img-fluid blur-up lazyload bg-img w-100"
                                                             alt="@Model.GetFullName()" />
                                                    </a>
                                                </div>
                                            </div>
                                            <div>
                                                <ul>
                                                    <li>
                                                        {{Total Trips}}
                                                    </li>
                                                    <li>
                                                        {{Rating}}
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cab-single-detail">
                                        <div class="title-car">
                                            <h5>About  Driver</h5>
                                            <!-- <h6>fare/km : <span>$24</span></h6> -->
                                        </div>
                                        <p class="description">
                                            @Html.Raw(Model.AboutOn)
                                        </p>
                                        <div class="overview">
                                            <h6>Driver Details</h6>
                                            <ul>
                                                <li>
                                                    @Model.GetFullName()
                                                </li>
                                                <li>
                                                    @Model.LicenseNumber
                                                </li>
                                            </ul>
                                            <ul>
                                                <li>
                                                    @Model?.Email
                                                </li>
                                                <li>
                                                    @Model.PhoneNumber
                                                </li>
                                            </ul>
                                            <ul>
                                                <li>
                                                    @Html.Raw(Model.Address)
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="details g-4 row">
                                            <div class="col-sm-6">
                                                <div class="overview">
                                                    <h6>include in this price:</h6>
                                                    <ul>
                                                        <li>cancellation</li>
                                                        <li>theft protection</li>
                                                        <li>local taxes</li>
                                                        <li>
                                                            Prices are inclusive of all the taxes
                                                        </li>
                                                        <li>fuel charges</li>
                                                        <li>driver allowance</li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="overview">
                                                    <h6>exclude in this price:</h6>
                                                    <ul>
                                                        <li>late return charges</li>
                                                        <li>Night Allowance</li>
                                                        <li>Parking</li>
                                                        <li>toll / state tax</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </section>
                    <!-- section end -->
                </div>
                @if (Model.Vehicle != null)
                {
                    <div class="card-body">
                        <!-- section start -->
                        <section class="single-section small-section bg-inner">
                            <div class="row">
                                <h2 class="cars-title mb-2 mt-2">Car Name</h2>
                                <div class="col-12">
                                    <div class="image_section">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="responsive arrow-dark zoom-gallery ratio2_3">
                                                    <div>
                                                        <a href="javascript:void(0)" onclick="ViewMediaGallary('@Model.Vehicle.Id')">
                                                            <img src="@Model.Vehicle.DefaultImage"
                                                                 class="img-fluid blur-up lazyload bg-img w-100"
                                                                 alt="@Model.Vehicle.ModelName" />
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="cab-single-detail">
                                            <div class="title-car">
                                                <h5>@Model.Vehicle.ModelName</h5>
                                                <!-- <h6>fare/km : <span>$24</span></h6> -->
                                            </div>
                                            <p class="description">
                                                @Html.Raw(Model.Vehicle.OtherInfromation)
                                            </p>
                                            @await Component.InvokeAsync("DriverTable", new { VehicleId = Model.Vehicle.Id })
                                            <div class="overview">
                                                <h6>car overview</h6>
                                                @*  @if (Model.VehicleFeatures.Count > 0)
                                                {
                                                    var chenks = Model.VehicleFeatures.Chunk(2);

                                                } *@
                                                <ul>
                                                    <li>
                                                        <img src="images/seat.png"
                                                             class="img-fluid blur-up lazyload"
                                                             alt="" />
                                                        @Model.Vehicle.Color
                                                    </li>
                                                    <li>
                                                        <img src="images/luggage.png"
                                                             class="img-fluid blur-up lazyload"
                                                             alt="" />
                                                        2 luggage
                                                    </li>
                                                </ul>
                                                <ul>
                                                    <li>
                                                        <img src="images/snowflake.png"
                                                             class="img-fluid blur-up lazyload"
                                                             alt="" />
                                                        AC
                                                    </li>
                                                    <li>
                                                        <img src="images/settings.png"
                                                             class="img-fluid blur-up lazyload"
                                                             alt="" />
                                                        automatic
                                                    </li>
                                                </ul>
                                            </div>
                                            <div class="details g-4 row">
                                                <div class="col-sm-6">
                                                    <div class="overview">
                                                        <h6>include in this price:</h6>
                                                        <ul>
                                                            <li>cancellation</li>
                                                            <li>theft protection</li>
                                                            <li>local taxes</li>
                                                            <li>
                                                                Prices are inclusive of all the taxes
                                                            </li>
                                                            <li>fuel charges</li>
                                                            <li>driver allowance</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="overview">
                                                        <h6>exclude in this price:</h6>
                                                        <ul>
                                                            <li>late return charges</li>
                                                            <li>Night Allowance</li>
                                                            <li>Parking</li>
                                                            <li>toll / state tax</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </section>
                        <!-- section end -->
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        function ViewMediaGallary(vehicleId){

        }
    </script>
}