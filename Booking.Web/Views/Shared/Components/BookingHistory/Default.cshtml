@model IEnumerable<Booking.Application.DTOs.BookingOrderDto>
@if (Model.Any())
{
    <div class="card">
        <div class="card-header">
            <div class="card-header-title">
                <h5>Booking History</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="dashboard-table table border-0">
                    <thead>
                        <tr>
                            <th>Tour</th>
                            <th>Title</th>
                            <th>Duration</th>
                            <th>Departure</th>
                            <th>Transit</th>
                            <th>Arrival</th>
                            <th>Status</th>
                            <th>Price</th>
                        </tr>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td><img src="" alt="" /></td>
                                <td>
                                    <span class="fw-500">@booking.PickupLocation</span><span>@booking.DropLocation</span>
                                </td>
                                <td><span> @booking.TripType </span></td>
                                <td>
                                    <span>
                                        <svg version="1.1"
                                             xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24">
                                            <title>flight_takeoff</title>
                                            <path d="M22.078 9.656q0.141 0.609-0.164 1.125t-0.914 0.703q-5.813 1.547-9.656 2.578l-5.297 1.406-1.594 0.469-2.625-4.5 1.453-0.375 1.969 1.5 4.969-1.313-4.125-7.172 1.922-0.516 6.891 6.422 5.344-1.406q0.609-0.188 1.148 0.141t0.68 0.938zM2.484 18.984h19.031v2.016h-19.031v-2.016z"></path>
                                        </svg>@booking.BookingDate.ToString("dd MMMM")
                                    </span>
                                </td>
                                <td>
                                    <span>@booking.ScheduledPickupTime</span>
                                    <span>@booking.ScheduledDropTime</span>
                                </td>
                                <td>
                                    <span>
                                        <svg version="1.1"
                                             xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24">
                                            <title>flight_land</title>
                                            <path d="M14.016 14.438q-3.844-1.078-9.656-2.578l-1.594-0.469v-5.156l1.453 0.375 0.938 2.344 4.969 1.313v-8.25l1.922 0.516 2.766 9 5.297 1.406q0.609 0.188 0.914 0.727t0.164 1.148q-0.188 0.609-0.703 0.891t-1.125 0.141zM2.484 18.984h19.031v2.016h-19.031v-2.016z"></path>
                                        </svg>@booking.BookingDate.ToString("dd MMMM")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-primary">@booking.Status</span>
                                </td>
                                <td><span>$@booking.EstimatedFare</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <div class="card-header-title">
                <h5>Booking History</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="w-100 dashboard-slider">
                <p>No Data...</p>
            </div>
        </div>
    </div>
}