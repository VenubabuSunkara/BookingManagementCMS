@model Booking.Web.Models.PackageViewModel
@{
    ViewData["Title"] = "Add New Package";
}
@section Styles {
    <!--MultiSelect-->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <!--Drop zon-->
    <link rel="stylesheet" type="text/css" href="~/css/dropzone.css" />
}

<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="card-header">
                            <h5>Add New Package Details</h5>
                        </div>
                        <div class="card-body">
                            <div id="container" class="container mt-5">
                                <div class="progress px-1" style="height: 3px">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: 0%"
                                         aria-valuenow="0"
                                         aria-valuemin="0"
                                         aria-valuemax="100"></div>
                                </div>
                                <div class="step-container d-flex justify-content-between">
                                    <div class="step-circle" onclick="displayStep(1)">
                                        1
                                    </div>
                                    <div class="step-circle" onclick="displayStep(2)">
                                        2
                                    </div>
                                    <div class="step-circle" onclick="displayStep(3)">
                                        3
                                    </div>
                                    @*   <div class="step-circle" onclick="displayStep(4)">
                                        4
                                    </div> *@
                                </div>

                                <form id="multi-step-form" class="theme-form mega-form" asp-action="SavePackage" asp-controller="Packages" method="post" enctype="multipart/form-data">
                                    <div class="step step-1">
                                        <!-- Step 1 form fields here -->
                                        <h3>Package Details</h3>
                                        <hr />
                                        <div class="row">
                                            <div class="col-6 mb-3">
                                                <label asp-for="PackagecategoryId" class="form-label-title">
                                                    Select Package Category
                                                </label>
                                                @Html.DropDownListFor(m => m.PackagecategoryId, Model.PackageCategory, "-- Select category --", new { @class = "form-control", @id = "ddlPackageCategory" })
                                                <span asp-validation-for="PackagecategoryId" class="text-danger"></span>
                                            </div>
                                            <div class="col-6 mb-3">
                                                <label asp-for="TourPackage.Title" class="form-label-title"></label>
                                                <input asp-for="TourPackage.Title" class="form-control" placeholder="Package Title" />
                                                <span asp-validation-for="TourPackage.Title" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb-3">
                                                <label asp-for="TourPackage.Price" class="form-label-title">Base Price</label>
                                                <input class="form-control" type="text" asp-for="TourPackage.Price" placeholder="Price" />
                                                <span asp-validation-for="TourPackage.Price" class="text-danger"></span>

                                            </div>
                                            <div class="col-6 mb-3">
                                                <label asp-for="TourPackage.DurationDays" class="form-label-title">Duration Days</label>
                                                <input class="form-control" asp-for="TourPackage.DurationDays" type="text" placeholder="days" />
                                                <span asp-validation-for="TourPackage.DurationDays" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label class="form-label-title" asp-for="TourPackage.ShortDescription">Description</label>
                                                <textarea class="form-control" rows="5" asp-for="TourPackage.ShortDescription" placeholder="package shot description"></textarea>
                                                <span asp-validation-for="TourPackage.ShortDescription" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label class="form-label-title" asp-for="TourPackage.FullDescription">Full Description</label>
                                                <textarea class="form-control" rows="5" asp-for="TourPackage.FullDescription" placeholder="package full description"></textarea>
                                                <span asp-validation-for="TourPackage.FullDescription" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <hr />
                                        <br />
                                        <div class="card-footer text-end">
                                            <button type="button"
                                                    class="btn btn-primary next-step">
                                                Next
                                            </button>
                                        </div>
                                    </div>
                                    <div class="step step-2">
                                        <!-- Step 2 form fields here -->
                                        <h3>Create Route</h3>
                                        <hr />
                                        <div class="row">
                                            <div class="col-6 mb-3">
                                                <label asp-for="location.LocationHeadLine"
                                                       class="form-label-title">Route Headline</label>
                                                <input class="form-control"
                                                       type="text" asp-for="location.LocationHeadLine"
                                                       placeholder="location name" />
                                                <span asp-validation-for="location.LocationHeadLine" class="text-danger"></span>

                                            </div>

                                            <div class="col-6 mb-3">
                                                <label asp-for="location.LocationName"
                                                       class="form-label-title">Location</label>
                                                <input class="form-control" id="autocomplete"
                                                       type="text" asp-for="location.LocationName"
                                                       placeholder="location" />
                                                <span asp-validation-for="location.LocationName" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label asp-for="location.Address"
                                                       class="form-label-title">Address</label>
                                                <textarea class="form-control" asp-for="location.Address" cols="15" rows="5" placeholder="address"></textarea>
                                                <span asp-validation-for="location.Country" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-3 mb-3">
                                                <label asp-for="location.Country"
                                                       class="form-label-title">Country</label>
                                                <input class="form-control" type="text" asp-for="location.Country" placeholder="country" />
                                                <span asp-validation-for="location.Country" class="text-danger"></span>

                                            </div>

                                            <div class="col-3 mb-3">
                                                <label asp-for="location.State" class="form-label-title">State</label>
                                                <input class="form-control" id="autocomplete" type="text" asp-for="location.State" placeholder="state" />
                                                <span asp-validation-for="location.State" class="text-danger"></span>

                                            </div>
                                            <div class="col-3 mb-3">
                                                <label asp-for="location.City"
                                                       class="form-label-title">City</label>
                                                <input class="form-control" type="text" asp-for="location.City" placeholder="city" />
                                                <span asp-validation-for="location.City" class="text-danger"></span>

                                            </div>

                                            <div class="col-3 mb-3">
                                                <label asp-for="location.ZipCode" class="form-label-title">Zip Code</label>
                                                <input class="form-control" id="autocomplete" type="text" asp-for="location.ZipCode" placeholder="zip code" />
                                                <span asp-validation-for="location.ZipCode" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-3 mb-3">
                                                <label asp-for=location.Latitude class="form-label-title">Route Latitude</label>
                                                <input class="form-control" asp-for="location.Latitude"
                                                       type="text"
                                                       placeholder="Latitude" />
                                                <span asp-validation-for="location.Latitude" class="text-danger"></span>

                                            </div>

                                            <div class="col-3 mb-3">
                                                <label asp-for="location.Longitude"
                                                       class="form-label-title">Longitude</label>
                                                <input class="form-control" asp-for="location.Longitude"
                                                       type="text"
                                                       placeholder="Add Route Longitude" />
                                                <span asp-validation-for="location.Longitude" class="text-danger"></span>

                                            </div>
                                            <div class="col-3 mb-3">
                                                <label class="form-label-title" asp-for="location.RouteDistance">Route Distance</label>
                                                <input class="form-control" asp-for="location.RouteDistance"
                                                       type="text"
                                                       placeholder="Route Distance in KM" />
                                                <span asp-validation-for="location.ZipCode" class="text-danger"></span>

                                            </div>

                                            <div class="col-3 mb-3">
                                                <label asp-for="location.RouteDuration"
                                                       class="form-label-title">Route Duration</label>
                                                <input class="form-control"
                                                       type="text" asp-for="location.RouteDuration"
                                                       placeholder="Add Route Duration" />
                                                <span asp-validation-for="location.ZipCode" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label asp-for="location.Description"
                                                       class="form-label-title">Route Description</label>
                                                <br />
                                                <textarea asp-for="location.Description"
                                                          placeholder="Route Description"
                                                          class="form-control"
                                                          rows="10"
                                                          id="descriptionOf"></textarea>
                                                <span asp-validation-for="location.ZipCode" class="text-danger"></span>

                                            </div>
                                        </div>
                                        <hr />
                                        <br />
                                        <div class="card-footer text-end">
                                            <button type="button"
                                                    class="btn btn-primary prev-step">
                                                Previous
                                            </button>
                                            <button type="button"
                                                    class="btn btn-primary next-step">
                                                Next
                                            </button>
                                        </div>
                                    </div>
                                    <div class="step step-3">
                                        <!-- Step 3 form fields here -->

                                        <div class="card-header card-header--2 package-card">
                                            <div>
                                                <h5>Tour Media</h5>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label class="form-label-title">
                                                    Upload Tour Banner Image here
                                                </label>
                                                <div class="dropzone" id="singleFileUpload" data-url="@Url.Action("Multiple", "Packages")">
                                                    <div class="dz-message needsclick">
                                                        <i class="icon-cloud-up"></i>
                                                        <h6>
                                                            Drop files here or click to upload.
                                                        </h6>
                                                        <span class="note needsclick">
                                                            (This is just a demo dropzone. Selected
                                                            files are <strong>not</strong> actually
                                                            uploaded.)
                                                        </span>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="SingleMediajson" />
                                            </div>
                                            @* </form> *@
                                        </div>

                                        <div class="row">
                                            @* <form action="/Packages/Multiple" enctype="multipart/form-data" method="post"> *@
                                            <div class="col-12 mb-3">
                                                <label class="form-label-title">
                                                    Upload Tour Gallery Image here
                                                </label>

                                                <div class="dropzone" id="multiFileUpload" data-url="@Url.Action("Multiple", "Packages")">
                                                    <div class="dz-message needsclick">
                                                        <i class="icon-cloud-up"></i>
                                                        <h6>
                                                            Drop files here or click to upload.
                                                        </h6>
                                                        <span class="note needsclick">
                                                            (This is just a demo dropzone. Selected
                                                            files are <strong>not</strong> actually
                                                            uploaded.)
                                                        </span>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="MultipleMediajson" />
                                            </div>
                                            @* </form> *@
                                        </div>

                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label asp-for="TourPackage.ThingsToNote"
                                                       class="form-label-title">Things to note</label>
                                                <textarea asp-for="TourPackage.ThingsToNote"
                                                          placeholder="Things to note"
                                                          class="form-control"
                                                          rows="5"
                                                          id=""></textarea>
                                                <span asp-validation-for="TourPackage.ThingsToNote" class="text-danger"></span>

                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <label asp-for="TourPackage.Inclusions"
                                                       class="form-label-title">
                                                    Inclusion/Exclusion / Terms and
                                                    conditions
                                                </label>
                                                <textarea asp-for="TourPackage.Inclusions"
                                                          placeholder="Terms and conditions"
                                                          class="form-control"
                                                          rows="5"
                                                          id=""></textarea>
                                                <span asp-validation-for="TourPackage.Inclusions" class="text-danger"></span>

                                            </div>
                                        </div>

                                        <div class="card-footer text-end">
                                            <button type="button"
                                                    class="btn btn-primary prev-step">
                                                Previous
                                            </button>
                                            <button type="submit" class="btn btn-success">
                                                Submit
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Container-fluid Ends-->
@section Scripts {
    <!--Searchable dropdown-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <!--Dropzon start-->
    <script src="~/js/dropzone.js" type="text/javascript"></script>
    <script src="~/js/dropzone-script.js" type="text/javascript"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.LocationApiKey&libraries=places"></script>
    <script>
        $(document).ready(function() {
          $('#ddlPackageCategory').select2({
            placeholder: "-- Select category --",
            allowClear: true
          });
        });
        function initAutocomplete() {
                // Find the textbox
                const input = document.getElementById("autocomplete");

                // Create the autocomplete object
                const autocomplete = new google.maps.places.Autocomplete(input, {
                  types: ["geocode"], // restricts to addresses
                  //componentRestrictions: { country: "in" } // optional: restrict to India
                });

                // When the user selects a place:
                autocomplete.addListener("place_changed", function () {
                  const place = autocomplete.getPlace();
                  const lat = place.geometry.location.lat();
                  const lng = place.geometry.location.lng();

                  console.log("Selected place:", place);
                  // You can access place.geometry.location.lat(), place.geometry.location.lng(), etc.
                });
              }

              // Initialize when page loads
              google.maps.event.addDomListener(window, 'load', initAutocomplete);
    </script>

}