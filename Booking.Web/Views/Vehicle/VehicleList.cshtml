@{
    ViewData["Title"] = "Vehicle List";
}
<link href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.4/css/buttons.dataTables.css">
<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header card-header--2">
                    <div>
                        <h5>All Vehicles</h5>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Driver" asp-action="Create" class="btn btn-theme">
                            <i data-feather="plus-square"></i>Add New
                        </a>

                        <form asp-controller="Vehicle" asp-action="Import" method="post" enctype="multipart/form-data">
                            <label class="btn btn-theme mb-0">
                                <i data-feather="file-plus"></i> Import
                                <input type="file" name="file" hidden onchange="this.form.submit()" />
                            </label>
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    <div>
                        <div class="table-desi">
                            @Html.AntiForgeryToken()
                            <table class="all-cars-table table table-striped w-100" id="tblvehicledriver">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Photo</th>
                                        <th>Model Name</th>
                                        <th>Make</th>
                                        <th>Color</th>
                                        <th>Fuel Type</th>
                                        <th>Base Price</th>
                                        <th>Vehicle Number</th>
                                        <th>Tax Rate</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                        <th>AssignDriver</th>
                                    </tr>
                                </thead>
                            </table>
                            <div class="pagination-box">
                                <nav aria-label="Table navigation">
                                    <ul id="customPaginate" class="pagination pagination-primary justify-content-center"></ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Popup {

}

<!-- Container-fluid ends-->
<!-- Container-fluid Ends-->
@section Scripts {
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
    <!-- DataTables Buttons extension -->
    <script src="https://cdn.datatables.net/buttons/3.2.4/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.4/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <!-- JSZip for Excel export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <!-- pdfmake for PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.4/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.4/js/buttons.print.min.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        var deleteId = null;
        var ApproveId=null;
         function approveVehicle(vehicleId){
             ApproveId=vehicleId;
             $("#approveParam").val(vehicleId);
             $('#approveConfirmModal').modal('show');
         }
            function ApproveConfirm(){
                  if (ApproveId) {
                      $.ajax({
                          type: "POST",
                          url: "/Vehicle/ApproveVehicle",
                          data: { VehicleId:ApproveId },
                          dataType: "json",
                          headers: {
                            'RequestVerificationToken': token
                          },
                          success: function(result) {
                            VehicleListVM.refresh();
                          },
                          error: function(req, status, error) {
                             console.error(error);
                          }
                     });
                 }
               }

         function rejectVehicle(vehicleId){
             deleteId=vehicleId;
             $("#deleteParam").val(vehicleId);
             $('#deleteConfirmModal').modal('show');
         }
         function DeleteConfirm(){
             if(deleteId)
             {
                 $.ajax({
                     type: "POST",
                     url: "/Vehicle/RejectVehicle",
                     data: { vehicleId:deleteId },
                     dataType: "json",
                     headers: {
                       'RequestVerificationToken': token
                     },
                     success: function(result) {
                        VehicleListVM.refresh();
                     },
                     error: function(req, status, error) {
                     console.error(error);
                     }
                 });
             }
         }

        function Preview(e, url) {
          e.preventDefault();
          location.href = url;
        }
         var  VehicleListVM = {
                 Vehicledt: null,
                 init: function () {
                      const token = $('input[name="__RequestVerificationToken"]').val();
                      this.Vehicledt = $('#tblvehicledriver').DataTable({
                      processing: true,
                      serverSide: true,
                      info: false,
                      stateSave: true,
                      paging: true,
                      pagingType: 'custom',
                      pageLength: 10,
                      lengthMenu: [10, 25, 50, { label: 'All', value: -1 }],
                      layout: {
                      topStart: {
                        buttons: [
                                   {
                                     extend: 'collection',
                                     text: 'Export All',
                                     buttons: [
                                       {
                                         extend: 'excel',
                                         text: 'Excel (Server)',
                                         action: function (e, dt, node, config) {
                                            setTimeout(function(){
                                               $(node).removeClass('processing');
                                            },500)
                                           window.location = '/Vehicle/ExportAll';
                                         }
                                       },
                                       'copy',
                                       'csv',
                                       'pdf',
                                       'print'
                                     ]
                                   }
                                 ]
                         },
                         bottomEnd: {
                             paging: {
                                 type: 'simple'
                             }
                         }
                     },

                      ajax: {
                             url: '/Vehicle/LoadVehicleData',
                             type: 'POST',
                             contentType: 'application/json; charset=utf-8',
                             dataType: 'json',
                             data: function (d) {
                                 return JSON.stringify(d); // Send as JSON string
                             },
                             headers: {
                                 'RequestVerificationToken': token
                             },
                             error: function (xhr, error, thrown) {
                                 console.error("DataTable error: ", xhr.responseText);
                             }
                         },
                      columns: [
                             {data:'id'},
                             { data: 'defaultImage',
                                 autoWidth: true,
                                 render: function (data, type, full, meta) {
                                     return `<img src="${data}" alt="${full.modelName}" class="img-thumbnail" style="height:40px;" />`;
                                 }
                             },
                             { data: 'modelName', autoWidth: true },
                             { data: 'make', autoWidth: true },
                             { data: 'color', autoWidth: true },
                             { data: 'fuelType', autoWidth: true },
                             { data: 'basePrice', autoWidth: true },
                             { data: 'vehicleNumber', autoWidth: true },
                             { data: 'taxRate', autoWidth: true },
                             { data: 'createdOn', autoWidth: true,
                                 render: function (data, type, row) {
                                    return moment(data).format('YYYY-MM-DD'); // Formats the date
                                 }
                             },
                             {
                                 data: 'id',
                                 render: function (data, type, full, meta) {
                                    let actions = !full.isActive
                                    ? `<a href="javascript:void(0)" title="approve vehicle" onclick="approveVehicle(${data})"><i class="fa fa-id-card"></i></a>`
                                    : `<a title="preview" href="/Vehicle/Preview?VehicleId=${data}" title="preview vehicle"><i class="fa fa-eye"></i></a> |
                                       <a href="/Vehicle/Edit?VehicleId=${data}" title="edit vehicle"><i class="fa fa-pencil-square-o"></i></a>`;
                                  actions += ` | <a href="javascript:void(0)" title="reject vehicle" onclick="rejectvehicle(${data})"><i class="fa fa-trash-o"></i></a>`;
                                  return actions;
                                 }
                             },
                             {
                                 data: 'id',
                                 render: function (data, type, full, meta) {
                                    return `<a href="javascript:void(0)" title="assign driver" onclick="AssignDriver(${data})"><i class="fa fa-taxi"></i></a>`
                                 }
                             }
                         ],
                           language: {
                                 emptyTable: "No entries to show"
                             },
                             drawCallback: () => this.renderPagination()
                     });
                 },
                 renderPagination: function() {
                          const info = this.Vehicledt.page.info();
                          const total = info.pages;
                          const current = info.page + 1;

                          const $ul = $('#customPaginate').empty();

                          // Previous button
                          $ul.append(
                            `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                               <button class="page-link" >Previous</button>
                             </li>`
                          );

                          // Page numbers
                          for (let i = 1; i <= total; i++) {
                            $ul.append(
                              `<li class="page-item ${i === current ? 'active' : ''}">
                                 <button  class="page-link" >${i}${i===current ? ' <span class="sr-only">(current)</span>' : ''}</button >
                               </li>`
                            );
                          }

                          // Next button
                          $ul.append(
                            `<li class="page-item ${current === total ? 'disabled' : ''}">
                               <button  class="page-link" >Next</button>
                             </li>`
                          );

                          // Click behaviors
                          $ul.find('li.page-item').each((idx, li) => {
                            const $li = $(li);
                            const $a = $li.find('button');

                            if ($li.hasClass('disabled') || $li.hasClass('active')) return;

                            $a.on('click', (e) => {
                              e.preventDefault();
                              if (idx === 0) this.Vehicledt.page('previous').draw(false);
                              else if (idx === total + 1) this.Vehicledt.page('next').draw(false);
                              else this.Vehicledt.page(idx - 1).draw(false);
                            });
                          });
                        },
                 refresh: function () {
                     if (this.Vehicledt) {
                         this.Vehicledt.ajax.reload();
                     }
                 },
                 draw:function(){
                     if (this.Vehicledt) {
                        this.Vehicledt.on('draw', renderPagination(this.Vehicledt));
                     }
                 }

             };
             $(document).ready(function () {
                 VehicleListVM.init();
         });


        function renderPagination(table) {
           var info = table.page.info();
           var totalPages = info.pages;
           var currentPage = info.page + 1;

           var $pag = $('#customPaginate').empty();

           // Previous button
           $pag.append(
             `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
               <a class="page-link" href="javascript:void(0)" tabindex="${currentPage === 1 ? '-1' : '0'}">Previous</a>
             </li>`
           );

           // Page number buttons
           for (var i = 1; i <= totalPages; i++) {
             $pag.append(
               `<li class="page-item ${i === currentPage ? 'active' : ''}">
                 <a class="page-link" href="javascript:void(0)">${i}${i === currentPage ? ' <span class="sr-only">(current)</span>' : ''}</a>
               </li>`
             );
           }

           // Next button
           $pag.append(
             `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
               <a class="page-link" href="javascript:void(0)" tabindex="${currentPage === totalPages ? '-1' : '0'}">Next</a>
             </li>`
           );

           // Bind click events
           $pag.find('li.page-item').each(function(index, item) {
             if ($(item).hasClass('disabled') || $(item).hasClass('active')) return;
             $(item).find('a').on('click', function() {
                $pag.find('li.page-item').removeClass('active');
                $(item).parent().addClass('active');
               if (index === 0) table.page('previous').draw(false);              // Previous
               else if (index === totalPages + 1) table.page('next').draw(false); // Next
               else table.page(index - 1).draw(false);                           // Specific page
             });
           });
         }

    </script>
}
