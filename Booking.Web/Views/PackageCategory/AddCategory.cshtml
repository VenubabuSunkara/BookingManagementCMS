@model Booking.Application.DTOs.Tour.TourPackageCategoryDto
@{
    ViewData["Title"] = "Add/Update Package Category";
}

<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-sm-12">
                    <form asp-action="SaveCategory" asp-controller="Packages" method="post"
                          enctype="multipart/form-data">
                        <div class="card">
                            <div class="card-header">
                                <h5>Add/Update Package Category</h5>
                            </div>
                            <div class="card-body">
                                <div class="theme-form mega-form">
                                    <input type="hidden" asp-for="Id" />
                                    <div class="mb-3">
                                        <label asp-for="CategoryName" class="form-label-title">Category Name</label>
                                        <input class="form-control"
                                               type="text"
                                               placeholder="Tour name" asp-for="CategoryName" />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NoOfPackages" class="form-label-title">Tour Places</label>

                                        <input class="form-control"
                                               type="text"
                                               name="tags" asp-for="NoOfPackages" />
                                    </div>

                                    <label asp-for="Description" class="form-label-title">Description</label>
                                    <textarea id="editor1" asp-for="Description"
                                              name="editor1"
                                              cols="30"
                                              rows="10">
                          </textarea>
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <button class="btn btn-primary me-3">Submit</button>
                                <button class="btn btn-outline-primary">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>